# local env + caches only
.venv/
.env
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.pyc
*.pyo
*.egg-info/

# Astar data is intentionally versioned and shared through git.
!data/
!data/**
data/catalog.duckdb

# Large replay event-ledger parquet files are reproducible local artifacts.
# Keep their summaries/versioned code in git, but not the raw ledger payloads.
data/artifacts/datasets/*/events.parquet
data/artifacts/datasets/*/riskset.parquet

# Model-specific synthetic posterior caches are reproducible local artifacts.
data/artifacts/datasets/f1_birth_posterior_synth__*/
data/artifacts/datasets/f1_summary_bank_synth__*/
data/artifacts/datasets/query_residual_synthetic_live__*/
data/artifacts/datasets/f1_synthetic_live_coverage_*__cfg_*/
data/artifacts/models/query_residual_shared/
